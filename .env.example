# Copy this file to .env and replace every example value.

# Folder or drive to share.
FILESPACE_ROOT=D:\
# Create or update "File Server.lnk" on the current user's Desktop.
FILESPACE_CREATE_SHORTCUT=true

FILESPACE_EMAIL=you@example.com
FILESPACE_PASSWORD=replace-with-a-long-unique-password

# Authentication mode: qr, password, or both.
FILESPACE_AUTH_MODE=qr

# Access mode examples:
# Same Wi-Fi: FILESPACE_ALLOWED_IPS=192.168.1.0/24
# Specific devices: FILESPACE_ALLOWED_IPS=192.168.1.25,192.168.1.40
# Public login page: FILESPACE_ALLOWED_IPS= and FILESPACE_PUBLIC=true
# Comma-separated addresses and CIDR ranges are supported.
FILESPACE_ALLOWED_IPS=

# true = any reachable device can reach the login page; login is still required.
# false = only allowed IPs can reach FileSpace; the local PC is always allowed.
FILESPACE_PUBLIC=true

# Candidate write access. Set false for read-only sharing.
CANDIDATE_FILE_UPLOAD_ENABLED=true
FILESPACE_UPLOAD_MAX_MB=1000
FILESPACE_UPLOAD_ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,gif,webp,bmp,mp4,m4v,mov,webm,mkv,ogv,txt,md,csv,json,docx,xlsx,pptx,rtf,odt,ods,odp
